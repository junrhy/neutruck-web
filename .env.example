# Port for the Express server
PORT=3001

# PostgreSQL Database Connection URL (Same DB used by NeuTruck desktop)
# Example: postgres://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL=postgres://postgres:password@localhost:5432/neutruck_db

# Set to true if PostgreSQL requires SSL
DB_SSL=true

# Node Environment
NODE_ENV=production
